[Unit]
Description=YaMusic tunnel connectivity check
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/sbin/yamusic-tunnel-health.py
StateDirectory=yamusic-tunnel-health
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=45
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
